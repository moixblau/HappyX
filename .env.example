# Copy to .env (git-ignored) and fill in. Never commit real values.
POSTGRES_USER=happyx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=happyx

# SHA-256 hex digests of the API keys allowed to call the API, comma separated.
# Generate one key per client with:
#   KEY=$(openssl rand -hex 32); echo "key:  $KEY"; echo -n "$KEY" | sha256sum
# Give the key to the client and put only the hash here.
API_KEY_HASHES=

# Discord bot token (https://discord.com/developers/applications > your app > Bot).
DISCORD_TOKEN=
# The bot's plaintext API key; its SHA-256 hash must be in API_KEY_HASHES.
BOT_API_KEY=

# Web dashboard login (optional; leave DISCORD_CLIENT_ID empty to disable it).
# Discord application > OAuth2: copy the Client ID and Secret, and add the redirect
#   <WEB_URL>/api/web/auth/callback   (locally: http://localhost:8084/api/web/auth/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_URL=http://localhost:8084
# Signs login sessions: openssl rand -hex 32
SESSION_SECRET=

# Admin dashboard (optional, owner only, local network only; served on ADMIN_PORT, default 8090).
# Generate a separate key; it must not be one of the API_KEY_HASHES keys:
#   KEY=$(openssl rand -hex 32); echo "key:  $KEY"; echo -n "$KEY" | sha256sum
# The admin container gets the key, the API only its hash.
ADMIN_API_KEY=
ADMIN_KEY_HASH=
